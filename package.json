{
	"name": "starter-kit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"name": "bun scripts/name.ts",
		"setup": "bun scripts/setup.ts",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --emit-ts-declarations --silent",
		"db:start": "docker compose up --detach --wait",
		"db:stop": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun scripts/seed.ts",
		"db:reset": "docker compose down --volumes && bun run db:start && bun run db:migrate && bun run db:seed",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "svelte-kit sync && auth generate --config src/lib/server/auth/index.ts --output src/lib/server/db/auth-schema.ts --yes && prettier --write src/lib/server/db/auth-schema.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.7",
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.26.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.27.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"auth": "^1.7.7",
		"bits-ui": "^2.20.0",
		"cn": "^0.4.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	}
}
