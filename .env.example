# Copied to .env by `bun run setup`, which fills in BETTER_AUTH_SECRET. `bun run` loads .env for every script.
# Never commit .env.

# The Postgres that `bun run db:start` runs in Docker (compose.yaml). When port 5432 is taken on your machine,
# set DATABASE_PORT (Docker reads it from .env) and the same port in DATABASE_URL.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/app"
# DATABASE_PORT=5433

# better-auth's secret for signing and encryption, at least 32 characters. `bun run setup` writes a fresh one;
# by hand: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The address the app answers at. better-auth answers under /api/auth only on this origin, so it follows the
# port `bun run dev` is on.
BETTER_AUTH_URL="http://localhost:5173"
